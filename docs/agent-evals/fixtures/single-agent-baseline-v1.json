{
  "version": 1,
  "name": "single-agent-baseline-v1",
  "description": "Current single-Agent baseline before Router/Specialist redesign. The cases cover recommendation quality and the five demo Agent paths.",
  "bootstrap_request": {
    "concern_text": "피지가 많고 모공이 넓어 고민이야",
    "skin_type": "수부지",
    "sensitivity": "보통",
    "avoid_ingredients": [],
    "required_ingredient_names": []
  },
  "cases": [
    {
      "id": "pore-oily-01",
      "group": "recommendation",
      "message": "피지가 많고 모공이 넓어 고민이야",
      "auth_mode": "guest",
      "context_mode": "home",
      "expect": {
        "tool_name": "create_recommendation",
        "requires_confirmation": false,
        "min_items": 1,
        "manual_review": true
      }
    },
    {
