# Copy this file to config.benchmark.local.env for Windows-local automation.
# Keep the real file out of Git. SSH_KEY is a local private-key path, not key contents.
SSH_USER="ubuntu"
SSH_HOST="<benchmark-server-host>"
SSH_KEY="C:/Users/user/.ssh/mwobareullae.pem"
REMOTE_APP_DIR="/home/ubuntu/mwobareullae"
REMOTE_BENCHMARK_ROOT="/home/ubuntu/mwobareullae-benchmark"
BASE_URL="https://dev.api.mubarelle.com/api"
VUS="1"
DURATION="30s"
SLA_MS="3000"
# Optional: pin one case id from docs/performance/queries/recommendation-v1.json.
QUERY_ID=""

# Required only for profile/skin_test/behavior runs.
BENCHMARK_PROFILE_USER_EMAIL=""
BENCHMARK_PROFILE_USER_PASSWORD=""
BENCHMARK_SKIN_TEST_USER_EMAIL=""
BENCHMARK_SKIN_TEST_USER_PASSWORD=""
BENCHMARK_BEHAVIOR_USER_EMAIL=""
BENCHMARK_BEHAVIOR_USER_PASSWORD=""

# Required for -UserType full-personalized.
# If BENCHMARK_FULL_PERSONALIZED_USER_EMAILS is empty, the k6 script generates
# benchmark_full_01@example.test through benchmark_full_10@example.test.
BENCHMARK_FULL_PERSONALIZED_USER_COUNT="10"
BENCHMARK_FULL_PERSONALIZED_USER_EMAIL_PREFIX="benchmark_full"
BENCHMARK_FULL_PERSONALIZED_USER_EMAIL_DOMAIN="example.test"
BENCHMARK_FULL_PERSONALIZED_USER_EMAILS=""
BENCHMARK_FULL_PERSONALIZED_USER_PASSWORD=""
