####################################################################
# 이 파일을 scripts/perf/config.env로 복사한 뒤 로컬 값에 맞게 수정합니다.
# config.env는 커밋하지 않습니다. secret은 git에 남기지 않습니다.
####################################################################

# Dev 서버 SSH 접속 정보입니다.
SSH_USER="ubuntu"
SSH_HOST="<dev-server-host-or-ip>"
SSH_KEY="<ssh-key-path>"

# Dev 서버의 앱 경로입니다.
REMOTE_APP_DIR="/home/ubuntu/mwobareullae"

# Docker Compose service/container 이름입니다.
BACKEND_SERVICE="backend"
BACKEND_CONTAINER="mwobareullae-backend"
REDIS_CONTAINER="mwobareullae-redis"
ELASTICSEARCH_CONTAINER="mwobareullae-elasticsearch"

# DB 관측 방식입니다.
# backend: backend 컨테이너의 DATABASE_URL로 RDS/DB 지표를 조회합니다. Dev 서버 기본값입니다.
# docker-postgres: local-db profile의 Docker Postgres를 직접 조회합니다.
DB_MONITOR_MODE="backend"

# docker-postgres 모드에서만 사용합니다.
POSTGRES_SERVICE="postgres"
POSTGRES_CONTAINER="mwobareullae-postgres"

# 테스트 대상 DB/데이터 라벨입니다.
# RDS를 쓰는 서버에서는 backend .env의 DATABASE_URL이 실제 연결 대상을 결정합니다.
# full data 기준이면 DB_NAME="mubarelle", DATA_DIR="/data", DATA_LABEL="full"로 맞춥니다.
DB_NAME="mubarelle_dev_small"
# DB_NAME="mubarelle_dev"
DB_USER="mubarelle"
DATA_DIR="/data/dev-small"
# DATA_DIR="/data"
DATA_LABEL="small-1000"

# k6
K6_SCRIPT="tests/k6/commerce-smoke.js"
BASE_URL="https://dev.api.mubarelle.com/api"

# true면 cart add/checkout preview까지 실제 write 요청을 보냅니다.
# 익명 cart 데이터가 생성되므로 baseline 기본값은 false입니다.
CART_WRITES="false"

# 비워두면 /products/popular 응답에서 product_id를 자동으로 뽑아 상세/추천 흐름에 사용합니다.
# popular 데이터가 비어 있거나 특정 상품만 고정해서 재현하고 싶을 때 comma로 지정합니다.
# 예: PRODUCT_IDS="prod_oy_a000000163734,prod_oy_a000000250344"
PRODUCT_IDS=""

# 비워두면 heavy_product_detail 단계는 건너뜁니다.
# 성분/이미지/상세 row가 많은 상품 상세 API만 별도로 압박하고 싶을 때 지정합니다.
# 예: HEAVY_PRODUCT_IDS="prod_oy_a000000258833"
HEAVY_PRODUCT_IDS=""

# 상품 검색 API에 사용할 대표 query입니다.
# 브랜드명보다 MVP 사용자가 자주 입력할 카테고리/성분/효능 단어를 섞어 검색 경로를 넓게 봅니다.
# 데이터셋에 맞춰 성분명/브랜드명/고민 키워드를 comma로 교체해도 됩니다.
SEARCH_QUERIES="세럼,수분 크림,나이아신아마이드,진정,선크림"

# true면 4xx/5xx 응답 body 일부를 k6 output에 찍습니다. 짧은 smoke 디버깅 때만 켭니다.
DEBUG_ERRORS="false"

# p95 latency 성공 기준(ms)입니다.
# run-loadtest.sh가 k6 threshold와 report PASS/FAIL 판정에 같은 값을 전달합니다.
# 3000이면 type=fast/search/write p95가 3초 미만이어야 통과합니다.
SLA_MS=3000

# 이미 알고 있는 시간 구간의 backend 로그만 수집하려면 RUN_K6=false로 둡니다.
RUN_K6="true"
START_TIME_UTC=""
END_TIME_UTC=""

# 모니터링 샘플링 주기입니다. 5면 5초마다 docker stats/DB 지표를 찍습니다.
SAMPLE_INTERVAL=5
RESULT_ROOT="perf-runs"

# Slack 전송은 webhook/token을 로컬 config.env에 설정했을 때만 켭니다.
SLACK_ENABLED="false"
SLACK_WEBHOOK_URL=""
SLACK_BOT_TOKEN=""
SLACK_CHANNEL=""
