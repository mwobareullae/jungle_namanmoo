####################################################################
# Copy this file to scripts/perf/config.env and fill local values.
# Do not commit config.env. Keep secrets out of git.
####################################################################

# Dev server SSH
SSH_USER="ubuntu"
SSH_HOST="<dev-server-host-or-ip>"
SSH_KEY="<ssh-key-path>"

# Remote repository path on the dev server
REMOTE_APP_DIR="/home/ubuntu/mwobareullae"

# Docker Compose service/container names
BACKEND_SERVICE="backend"
POSTGRES_SERVICE="postgres"
BACKEND_CONTAINER="mwobareullae-backend"
POSTGRES_CONTAINER="mwobareullae-postgres"
REDIS_CONTAINER="mwobareullae-redis"
ELASTICSEARCH_CONTAINER="mwobareullae-elasticsearch"

# Database used by the run. For full data, set DB_NAME="mwobareullae".
DB_NAME="mwobareullae_small"
DB_USER="mwobareullae"
DATA_DIR="/data/dev-small"
DATA_LABEL="small-1000"

# k6
K6_SCRIPT="tests/k6/commerce-smoke.js"
BASE_URL="https://dev.api.mubarelle.com/api"
CART_WRITES="false"
PRODUCT_IDS=""
HEAVY_PRODUCT_IDS=""
SEARCH_QUERIES="세럼,수분 크림,나이아신아마이드,진정,선크림"
DEBUG_ERRORS="false"
SLA_MS=3000

# Set RUN_K6=false to only collect backend logs for an already-known time window.
RUN_K6="true"
START_TIME_UTC=""
END_TIME_UTC=""

# Monitoring
SAMPLE_INTERVAL=10
RESULT_ROOT="perf-runs"

# Optional Slack delivery. Keep false unless webhook/token are configured locally.
SLACK_ENABLED="false"
SLACK_WEBHOOK_URL=""
SLACK_BOT_TOKEN=""
SLACK_CHANNEL=""
