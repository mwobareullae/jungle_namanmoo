####################################################################
# 이 파일을 scripts/perf/config.env로 복사한 뒤 로컬 값에 맞게 수정합니다.
# config.env는 커밋하지 않습니다. secret은 git에 남기지 않습니다.
####################################################################

# Dev 서버 SSH 접속 정보입니다.
SSH_USER="ubuntu"
SSH_HOST="<dev-server-host-or-ip>"
SSH_KEY="<ssh-key-path>"

# Dev 서버의 앱 경로입니다.
REMOTE_APP_DIR="/home/ubuntu/mwobareullae"

# Docker Compose service/container 이름입니다.
BACKEND_SERVICE="backend"
BACKEND_CONTAINER="mwobareullae-backend"
REDIS_CONTAINER="mwobareullae-redis"
ELASTICSEARCH_CONTAINER="mwobareullae-elasticsearch"

# DB 관측 방식입니다.
# backend: backend 컨테이너의 DATABASE_URL로 RDS/DB 지표를 조회합니다. Dev 서버 기본값입니다.
# docker-postgres: local-db profile의 Docker Postgres를 직접 조회합니다.
DB_MONITOR_MODE="backend"

# docker-postgres 모드에서만 사용합니다.
POSTGRES_SERVICE="postgres"
POSTGRES_CONTAINER="mwobareullae-postgres"

# 테스트 대상 DB/데이터 라벨입니다.
# RDS를 쓰는 서버에서는 backend .env의 DATABASE_URL이 실제 연결 대상을 결정합니다.
# full data 기준이면 DB_NAME="mwobareullae", DATA_DIR="/data", DATA_LABEL="full"로 맞춥니다.
DB_NAME="mwobareullae_small"
DB_USER="mwobareullae"
DATA_DIR="/data/dev-small"
DATA_LABEL="small-1000"

# k6
K6_SCRIPT="tests/k6/commerce-smoke.js"
BASE_URL="https://dev.api.mubarelle.com/api"
CART_WRITES="false"
PRODUCT_IDS=""
HEAVY_PRODUCT_IDS=""
SEARCH_QUERIES="세럼,수분 크림,나이아신아마이드,진정,선크림"
DEBUG_ERRORS="false"
SLA_MS=3000

# 이미 알고 있는 시간 구간의 backend 로그만 수집하려면 RUN_K6=false로 둡니다.
RUN_K6="true"
START_TIME_UTC=""
END_TIME_UTC=""

# 모니터링 샘플링 주기입니다. 5면 5초마다 docker stats/DB 지표를 찍습니다.
SAMPLE_INTERVAL=5
RESULT_ROOT="perf-runs"

# Slack 전송은 webhook/token을 로컬 config.env에 설정했을 때만 켭니다.
SLACK_ENABLED="false"
SLACK_WEBHOOK_URL=""
SLACK_BOT_TOKEN=""
SLACK_CHANNEL=""
