# Copy this file to the server-local benchmark runtime directory.
# Do not commit the real benchmark database URL or credentials.
BENCHMARK_RUNTIME_ROOT="/home/ubuntu/mwobareullae-benchmark"
BENCHMARK_DATA_HOST_DIR="/home/ubuntu/mwobareullae-benchmark/data"
BENCHMARK_DATABASE_URL="postgresql+psycopg://<user>:<password>@<benchmark-db-host>:5432/mubarelle_bench_1000"
BENCHMARK_ACTIVATE="false"
BENCHMARK_RESULT_ROOT="/home/ubuntu/mwobareullae-benchmark/runs"
BENCHMARK_LOG_TAIL="5000"
BENCHMARK_RDS_METRICS_ENABLED="false"
BENCHMARK_REDIS_KEY_PREFIX=""
BENCHMARK_SERVER_HOST="<benchmark-server-host>"
BENCHMARK_USER_TYPE="anonymous"
BENCHMARK_VUS="1"
BENCHMARK_DURATION="30s"
BENCHMARK_K6_RESULT_FILE=""
BENCHMARK_VERIFY_USERS="false"
# Login credentials are supplied only when running k6; keep real values out of Git.
BENCHMARK_PROFILE_USER_EMAIL=""
BENCHMARK_PROFILE_USER_PASSWORD=""
BENCHMARK_SKIN_TEST_USER_EMAIL=""
BENCHMARK_SKIN_TEST_USER_PASSWORD=""
BENCHMARK_BEHAVIOR_USER_EMAIL=""
BENCHMARK_BEHAVIOR_USER_PASSWORD=""

# Used by benchmarkctl seed-users and USER_TYPE=full-personalized.
# The password must be set only in the server-local ignored config file.
BENCHMARK_FULL_PERSONALIZED_USER_COUNT="10"
BENCHMARK_FULL_PERSONALIZED_USER_EMAIL_PREFIX="benchmark_full"
BENCHMARK_FULL_PERSONALIZED_USER_EMAIL_DOMAIN="example.test"
BENCHMARK_FULL_PERSONALIZED_USER_EMAILS=""
BENCHMARK_FULL_PERSONALIZED_USER_PASSWORD=""
