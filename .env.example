# 이 파일을 .env로 복사한 뒤 로컬/Dev 서버 값에 맞게 수정합니다.
# 실제 secret은 커밋하지 않습니다.
# VITE_ prefix 값은 브라우저에 노출됩니다.

# -----------------------------------------------------------------------------
# Common / App
# -----------------------------------------------------------------------------
APP_NAME=mubarelle
APP_ENV=local

# -----------------------------------------------------------------------------
# Frontend public runtime
# 브라우저 공개값입니다. VITE_*에는 secret을 넣지 않습니다.
# Vercel Production/Preview 값은 Vercel dashboard에서 설정합니다.
# -----------------------------------------------------------------------------
VITE_APP_MODE=commerce
VITE_API_BASE_URL=http://localhost:8000/api
VITE_ENABLE_MOCKS=false
VITE_USE_AUTH_MOCK=false
VITE_GA_MEASUREMENT_ID=
VITE_IMAGE_CDN_BASE_URL=https://d3hg0esuwey1za.cloudfront.net
VITE_GOOGLE_CLIENT_ID=
VITE_TOSS_CLIENT_KEY=

# Vercel/dev frontend 예시:
# VITE_API_BASE_URL=https://dev.api.mubarelle.com/api
#
# Community preview 예시:
# VITE_APP_MODE=community
# VITE_API_BASE_URL=https://api.mubarelle.com/api

# -----------------------------------------------------------------------------
# Backend runtime / API
# -----------------------------------------------------------------------------
API_BASE_PATH=/api
# 허용할 frontend origin 목록입니다. 여러 개는 comma로 구분합니다.
# fetch(..., { credentials: "include" }) 요청에 필요합니다.
# local/dev 기본값은 좁게 두고, release origin은 release 서버 .env에만 넣습니다.
BACKEND_CORS_ORIGINS=http://localhost:5173
UVICORN_WORKERS=2
# Release 서버 예시:
# BACKEND_CORS_ORIGINS=https://mubarelle.com,https://www.mubarelle.com
# 한 backend가 local/release origin을 함께 허용해야 할 때:
# BACKEND_CORS_ORIGINS=http://localhost:5173,https://mubarelle.com,https://www.mubarelle.com

# -----------------------------------------------------------------------------
# Backend auth / session cookies
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET_KEY=change-me-local-secret
AUTH_SESSION_COOKIE_NAME=mwbl_session
AUTH_SESSION_TTL_DAYS=14
# 로컬 HTTP는 false, 배포 HTTPS 환경은 true로 둡니다.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# 주간 논문 수집기가 호출하는 내부 적재 API의 공유 토큰입니다.
# 실제 값은 배포 환경과 GitHub Actions secret에만 설정합니다.
EVIDENCE_INGEST_TOKEN=change-me-evidence-ingest-token

# -----------------------------------------------------------------------------
# Backend data / logging
# -----------------------------------------------------------------------------
# full seed는 200만+ 성분 row를 처리합니다.
# backend 메모리가 충분할 때만 50000/100000으로 올립니다.
SEED_PRODUCT_INGREDIENT_BATCH_SIZE=10000
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_LOGGING=true
ENABLE_DB_SLOW_QUERY_LOGGING=true
DB_SLOW_QUERY_THRESHOLD_MS=100

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mubarelle.com
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Social login
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Payment
# -----------------------------------------------------------------------------
TOSS_SECRET_KEY=

# -----------------------------------------------------------------------------
# OpenAI / AI features
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_AGENT_MODEL=gpt-5.5
AGENT_RELEASE=local
OPENAI_AGENT_TIMEOUT_SECONDS=15
OPENAI_AGENT_MAX_RETRIES=1
OPENAI_AGENT_MAX_CONCURRENCY=3
OPENAI_AGENT_QUEUE_TIMEOUT_SECONDS=10
OPENAI_AGENT_BUSY_RETRY_AFTER_SECONDS=2
OPENAI_AGENT_GLOBAL_LEASE_TTL_SECONDS=45
OPENAI_AGENT_AUTHENTICATED_RATE_LIMIT_PER_MINUTE=30
OPENAI_AGENT_ANONYMOUS_RATE_LIMIT_PER_MINUTE=20
OPENAI_AGENT_CIRCUIT_FAILURE_THRESHOLD=3
OPENAI_AGENT_CIRCUIT_COOLDOWN_SECONDS=30
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Recommendation / search tuning
# -----------------------------------------------------------------------------
# 두 weight 합은 1.0에 가깝게 유지합니다.
HYBRID_KEYWORD_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5

# 후보 pool을 키우면 품질은 좋아질 수 있지만 DB/query latency가 늘 수 있습니다.
RECOMMENDATION_CANDIDATE_POOL_LIMIT=500
# legacy_bulk, compact_v2, coarse_top50_v1 중 하나를 사용합니다.
RECOMMENDATION_SCORING_READ_PATH=legacy_bulk
RECOMMENDATION_CANDIDATE_CACHE_ENABLED=false
RECOMMENDATION_CANDIDATE_CACHE_TTL_SECONDS=300
RECOMMENDATION_CANDIDATE_PRICE_CACHE_TTL_SECONDS=60
RECOMMENDATION_CANDIDATE_CACHE_SOCKET_CONNECT_TIMEOUT_SECONDS=0.05
RECOMMENDATION_CANDIDATE_CACHE_SOCKET_TIMEOUT_SECONDS=0.05

# vector DB/index 생성 후에는 migration/index rebuild 계획 없이 바꾸지 않습니다.
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Database / seed data
# DATABASE_URL은 backend DB 연결 문자열입니다.
# DATA_DIR은 seed/index/embedding 스크립트가 읽을 CSV 경로입니다.
# DATABASE_URL과 DATA_DIR은 같은 데이터 크기 기준으로 함께 바꿉니다.
# 서버 배포는 RDS DATABASE_URL을 사용하며 Docker Postgres를 실행하지 않습니다.
# -----------------------------------------------------------------------------
# 로컬 Docker Postgres 기본값입니다. local-db profile에서 사용합니다.
DATABASE_URL=postgresql+psycopg://mwobareullae:change-me@postgres:5432/mwobareullae
DATA_DIR=/data

# Dev/Release 서버 RDS 예시입니다. 서버 .env에는 RDS endpoint를 직접 넣습니다.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<rds-endpoint>:5432/mwobareullae
# DATA_DIR=/data
#
# 서버 RDS small DB 예시입니다.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<rds-endpoint>:5432/mwobareullae_small
# DATA_DIR=/data/dev-small
#
# 로컬 Docker small DB 예시입니다.
# DATABASE_URL=postgresql+psycopg://mwobareullae:change-me@postgres:5432/mwobareullae_small
# DATA_DIR=/data/dev-small

# POSTGRES_*는 local-db profile의 Docker Postgres 초기화/포트 설정값입니다.
# 서버 배포에서는 사용하지 않습니다.
POSTGRES_PORT=5432
POSTGRES_DB=mwobareullae
POSTGRES_USER=mwobareullae
POSTGRES_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Docker Compose profiles / ports
# -----------------------------------------------------------------------------
# 필요한 조합은 실행 명령에서 --profile로 명시합니다.
# server: 서버 배포용 backend + Redis + Elasticsearch
# backend-dev: backend + 로컬 Postgres + Redis + Elasticsearch
# frontend-local-backend: frontend + backend + 로컬 Postgres
# frontend-dev-server: frontend만 실행하고 API는 개발 서버 사용
# frontend/local-db/search-cache: 기존 명령 호환용 profile
COMPOSE_PROJECT_NAME=mwobareullae
COMPOSE_PROFILES=

FRONTEND_PORT=5173
BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# Docker logging / resource limits
# -----------------------------------------------------------------------------
# Dev 기본 권장값: 10m x 5 files = 컨테이너당 최대 약 50MB.
# API/batch 장애 로그를 남기면서 디스크 증가를 제한합니다.
# 장시간 부하테스트 중에는 늘리고, 디스크가 부족할 때만 줄입니다.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# t3.large Dev API 서버 기준 권장값입니다.
# RDS 전환 후 서버에서는 Postgres 컨테이너를 기본 실행하지 않습니다.
# FRONTEND/POSTGRES limit은 로컬 profile 실행 시에만 의미가 있습니다.
FRONTEND_MEMORY_LIMIT=1g
BACKEND_MEMORY_LIMIT=2g
POSTGRES_MEMORY_LIMIT=2g

# -----------------------------------------------------------------------------
# Redis / Elasticsearch dev infrastructure
# -----------------------------------------------------------------------------
# 기본 bind는 127.0.0.1입니다. 외부에 공개하지 않습니다.
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=mubarelle:dev:
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_MEMORY_LIMIT=512m
REDIS_MAXMEMORY=256mb

SEARCH_BACKEND_MODE=auto
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=mubarelle_dev
ELASTICSEARCH_PRODUCTS_ALIAS=mubarelle_dev_products_current
ELASTICSEARCH_CATALOG_PRODUCTS_ALIAS=mubarelle_dev_catalog_products_current
ELASTICSEARCH_TIMEOUT_SECONDS=2.0
ELASTICSEARCH_MAX_RETRIES=0
ELASTICSEARCH_CIRCUIT_BREAKER_SECONDS=60
ELASTICSEARCH_BIND_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_MEMORY_LIMIT=2g
ELASTICSEARCH_HEAP_SIZE=1g

# -----------------------------------------------------------------------------
# Optional proxy
# docker-compose.proxy.yml에서만 사용합니다.
# -----------------------------------------------------------------------------
API_DOMAIN=api.mubarelle.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Batch / image assets
# 현재 S3/CloudFront 이미지 batch 대상입니다.
# data/scripts/download_product_images.py 실행 시 전달합니다.
# -----------------------------------------------------------------------------
IMAGE_S3_BUCKET=mubarelle-images
IMAGE_AWS_REGION=ap-northeast-2
