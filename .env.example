# Copy this file to .env and fill values for your local or dev server environment.
# Do not commit real secrets.
# Variables prefixed with VITE_ are exposed to the browser.

# -----------------------------------------------------------------------------
# Common / App
# -----------------------------------------------------------------------------
APP_NAME=mubarelle
APP_ENV=local

# -----------------------------------------------------------------------------
# Frontend public runtime
# Browser-visible values. Do not put secrets in VITE_* variables.
# -----------------------------------------------------------------------------
VITE_APP_MODE=commerce
VITE_API_BASE_URL=http://localhost:8000/api
VITE_ENABLE_MOCKS=false
VITE_GA_MEASUREMENT_ID=
VITE_IMAGE_CDN_BASE_URL=https://d3hg0esuwey1za.cloudfront.net
VITE_GOOGLE_CLIENT_ID=

# Community preview example:
# VITE_APP_MODE=community
# VITE_API_BASE_URL=https://api.mubarelle.com/api

# -----------------------------------------------------------------------------
# Backend runtime
# -----------------------------------------------------------------------------
API_BASE_PATH=/api
# Comma-separated allowed frontend origins.
# Required for browser requests that use fetch(..., { credentials: "include" }).
# Keep local/dev narrow by default. Put release origins in the release server .env.
BACKEND_CORS_ORIGINS=http://localhost:5173
# Release server example:
# BACKEND_CORS_ORIGINS=https://mubarelle.com,https://www.mubarelle.com
# If one backend must allow local and release origins:
# BACKEND_CORS_ORIGINS=http://localhost:5173,https://mubarelle.com,https://www.mubarelle.com
AUTH_JWT_SECRET_KEY=change-me-local-secret
AUTH_SESSION_COOKIE_NAME=mwbl_session
AUTH_SESSION_TTL_DAYS=14
# Local HTTP development uses false. Deployed HTTPS environments must use true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
DATA_DIR=/data
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_LOGGING=true
ENABLE_DB_SLOW_QUERY_LOGGING=true
DB_SLOW_QUERY_THRESHOLD_MS=100

# -----------------------------------------------------------------------------
# External integrations
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mubarelle.com
SMTP_USE_TLS=true

GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
TOSS_SECRET_KEY=
VITE_TOSS_CLIENT_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_AGENT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Recommendation / search tuning
# -----------------------------------------------------------------------------
# Keep HYBRID_KEYWORD_WEIGHT + HYBRID_VECTOR_WEIGHT close to 1.0.
HYBRID_KEYWORD_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5

# Larger pool can improve recommendation quality but may increase DB/query latency.
RECOMMENDATION_CANDIDATE_POOL_LIMIT=500

# Do not change after vector DB/index is created unless migrations/index rebuild are updated.
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Database
# DATABASE_URL is the backend connection string.
# POSTGRES_* values initialize/configure the Docker Compose postgres service.
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_DB=mwobareullae
POSTGRES_USER=mwobareullae
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://mwobareullae:change-me@postgres:5432/mwobareullae

# -----------------------------------------------------------------------------
# Docker Compose / infra
# -----------------------------------------------------------------------------
# Enables Redis/Elasticsearch services in docker-compose.yml.
# Keep this on for the t3.xlarge dev server; set empty locally if you only need app/postgres.
COMPOSE_PROFILES=dev-infra

FRONTEND_PORT=5173
BACKEND_PORT=8000

# Recommended dev default: 10m x 5 files = up to 50MB per container.
# This keeps enough recent logs for API/batch failure debugging while limiting disk growth.
# Increase during long load tests; decrease only when disk space is tight.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Recommended for the upgraded dev server target: RAM 8GB+ / vCPU 2+.
# 1g/2g/2g keeps frontend/backend/postgres bounded while leaving host memory for Docker and OS.
# Increase backend/postgres first if 100k import/search tests are killed by OOM.
FRONTEND_MEMORY_LIMIT=1g
BACKEND_MEMORY_LIMIT=2g
POSTGRES_MEMORY_LIMIT=2g

# Redis / Elasticsearch dev infrastructure.
# Host bind defaults to 127.0.0.1 so SSH tunnels can use the services without public exposure.
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=mubarelle:dev:
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_MEMORY_LIMIT=512m
REDIS_MAXMEMORY=256mb

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=mubarelle_dev
ELASTICSEARCH_BIND_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_MEMORY_LIMIT=2g
ELASTICSEARCH_HEAP_SIZE=1g

# Role-specific local compose modes.
# backend-dev-tunnel containers reach host SSH tunnels through host.docker.internal.
DEV_TUNNEL_DATABASE_URL=postgresql+psycopg://mwobareullae:change-me@host.docker.internal:5432/mwobareullae
DEV_TUNNEL_REDIS_URL=redis://host.docker.internal:6379/0
DEV_TUNNEL_ELASTICSEARCH_URL=http://host.docker.internal:9200

# -----------------------------------------------------------------------------
# Optional proxy
# Used only with docker-compose.proxy.yml.
# -----------------------------------------------------------------------------
API_DOMAIN=api.mubarelle.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Batch / image assets
# These values document the current S3/CloudFront image batch target.
# Pass them to data/scripts/download_product_images.py when running the batch.
# -----------------------------------------------------------------------------
IMAGE_S3_BUCKET=mubarelle-images
IMAGE_AWS_REGION=ap-northeast-2
