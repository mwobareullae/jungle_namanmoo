# Copy this file to .env and fill values for your local environment.
# Do not commit real secrets.
# Variables prefixed with VITE_ are exposed to the browser.

# App
APP_NAME=mwobareullae
APP_ENV=local

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCK_API=false

# Backend
BACKEND_PORT=8000
API_BASE_PATH=/api
BACKEND_CORS_ORIGINS=http://localhost:5173

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mwobareullae
POSTGRES_USER=mwobareullae
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://mwobareullae:change-me@postgres:5432/mwobareullae

# AI / LLM
# Fill these only when LLM parsing or embedding features are implemented.
# If OPENAI_API_KEY is empty, backend uses local-hash-v1 for no-cost local vector smoke tests.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Seed / Data
DATA_DIR=/data
SEED_ENABLED=false

# Logging
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true
